# Plaid Sandbox credentials from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_sandbox_secret
PLAID_ENV=sandbox

# Local PostgreSQL started by `mise exec -- pnpm db:up`
DATABASE_URL=postgresql://atama:atama@localhost:5432/atama

# Generate with: openssl rand -base64 32. Never reuse or commit this value.
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
# Use the public HTTPS application origin in production.
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
AUTH_EMAIL_FROM=atama <auth@example.com>

# Generate with: openssl rand -base64 32
PLAID_TOKEN_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key

# Optional. Leave unset unless Plaid can reach your local webhook tunnel.
PLAID_WEBHOOK_URL=
